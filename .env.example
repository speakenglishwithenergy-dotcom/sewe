# Chat LLM fallback: gemini → groq → cerebras (quota / rate-limit only).
# Leave LLM_PROVIDER unset to use the chain. Pin with: gemini | groq | cerebras | openai
# LLM_PROVIDER=gemini

# Gemini — https://aistudio.google.com/apikey
# Multiple keys: comma / semicolon separated. Exhausted keys are skipped for the rest of the process.
GEMINI_API_KEY=key1,key2
# Or: GEMINI_API_KEYS=key2,key3  (merged with GEMINI_API_KEY)
# Optional: Gemini model (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Groq — used for script/JSON generation (OpenAI-compatible API)
GROQ_API_KEY=gsk_key1,gsk_key2
# Or: GROQ_API_KEYS=gsk_key2,gsk_key3

# Optional: Groq model (default: qwen/qwen3.8-27b)
GROQ_MODEL=qwen/qwen3.8-27b

# Cerebras — last fallback — https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Or: CEREBRAS_API_KEYS=key1,key2
# Optional: Cerebras model (default: gpt-oss-120b; llama-3.3-70b was deprecated)
# CEREBRAS_MODEL=gpt-oss-120b

# OpenAI API Key — required for TTS; also used for LLM when no Gemini/Groq/Cerebras key is set.
# Image/thumbnails: used when IMAGE_PROVIDER=openai, or when GEMINI_API_KEY is unset.
OPENAI_API_KEY=sk-...

# Optional: OpenAI model for script generation (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional: TTS model (default: tts-1, use tts-1-hd for higher quality)
OPENAI_TTS_MODEL=tts-1

# Image provider for thumbnails/backgrounds (no cross-provider fallback).
# IMAGE_PROVIDER=gemini | openai
# Unset → Gemini if GEMINI_API_KEY exists, otherwise OpenAI.
# IMAGE_PROVIDER=gemini

# Optional: Gemini image model (default: gemini-2.5-flash-image)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: OpenAI image model (default: gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1

# Optional: Supertonic TTS quality (5–12, default: 10). Higher = more stable, slower.
SUPERTONIC_TOTAL_STEPS=10

# Optional: Retry count when TTS output looks corrupted (default: 3)
SUPERTONIC_TTS_RETRIES=3

# Optional: Skip API thumbnail generation — paste prompt into an image tool, save PNG to project folder
# DISABLE_THUMBNAIL_GENERATION=true

# Optional: Episode profile for CI / quick tests (production | test)
# test → compact podcast stub + short ~30–60s; batch also publishes immediately (--now)
# EPISODE_PROFILE=test
# BATCH_GENERATE_FLAGS=--short
# BATCH_PUBLISH_NOW=true

# ─── Auto-publish (per channel) ──────────────────────────────────────────────
# Each channel uses env vars prefixed with its env.prefix from channel.yaml.
# Example for speak-english-with-energy (prefix: SEWE):
#   npm run youtube:auth -- --channel=speak-english-with-energy
#   npm run tiktok:auth -- --channel=speak-english-with-energy
#
# SEWE_YOUTUBE_CLIENT_ID=
# SEWE_YOUTUBE_CLIENT_SECRET=
# SEWE_YOUTUBE_REFRESH_TOKEN=
# SEWE_YOUTUBE_PUBLISH_PRIVACY=private
# SEWE_YOUTUBE_CATEGORY_ID=27
# SEWE_FACEBOOK_PAGE_ID=
# SEWE_FACEBOOK_PAGE_ACCESS_TOKEN=
# SEWE_FACEBOOK_PUBLISH_LIVE=false
# SEWE_FACEBOOK_FIRST_COMMENT=true
# SEWE_TIKTOK_PUBLISH_ENABLED=false  # also omits TikTok from generated social metadata when false
# SEWE_TIKTOK_CLIENT_KEY=
# SEWE_TIKTOK_CLIENT_SECRET=
# SEWE_TIKTOK_ACCESS_TOKEN=
# SEWE_TIKTOK_REFRESH_TOKEN=
# SEWE_TIKTOK_PUBLISH_PRIVACY=SELF_ONLY
#
# Legacy unprefixed vars still work for speak-english-with-energy only:
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# ─── Weekly batch reminder (Monday email) ─────────────────────────────────────
# Get API key at https://resend.com — free tier works for personal reminders.
# REMINDER_EMAIL_TO=you@gmail.com
# RESEND_API_KEY=re_...
# REMINDER_EMAIL_FROM=SEWE Reminder <onboarding@resend.dev>
# REMINDER_TIMEZONE=Asia/Ho_Chi_Minh
# REMINDER_CHANNEL_ID=speak-english-with-energy
# REMINDER_HOUR=8
# REMINDER_MINUTE=0
