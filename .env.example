# OpenAI API Key (required)
OPENAI_API_KEY=sk-...

# Optional: OpenAI model for script generation (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional: TTS model (default: tts-1, use tts-1-hd for higher quality)
OPENAI_TTS_MODEL=tts-1

# Optional: Image model for thumbnail generation (default: gpt-image-1)
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional: Supertonic TTS quality (5–12, default: 10). Higher = more stable, slower.
SUPERTONIC_TOTAL_STEPS=10

# Optional: Retry count when TTS output looks corrupted (default: 3)
SUPERTONIC_TTS_RETRIES=3

# Optional: Skip OpenAI thumbnail generation — paste prompt into ChatGPT, save PNG to project folder
# DISABLE_THUMBNAIL_GENERATION=true

# ─── Auto-publish (YouTube + Facebook) ───────────────────────────────────────
# YouTube: create OAuth Desktop credentials + enable YouTube Data API v3, then run:
#   npm run youtube:auth
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_PUBLISH_PRIVACY=private
# YOUTUBE_CATEGORY_ID=27

# Facebook: create a Meta app, get a long-lived Page access token with pages_manage_posts
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_PUBLISH_LIVE=false

# TikTok: enable Login Kit (Desktop) + Content Posting API (video.publish scope)
# Register redirect URI: http://localhost:53683/callback
#   npm run tiktok:auth
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_REFRESH_TOKEN=
# TIKTOK_PUBLISH_PRIVACY=SELF_ONLY
